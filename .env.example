# 프로그램을 실행하는 디렉터리에 이 파일을 .env로 복사하세요.
PC_PCID=
keyCookie=
MAC=
MLCP=

# cURL 폼 데이터에서 복사한 chkcapt는 URL 디코딩을 한 번 한 뒤 .env에 저장하세요(예: %2F -> /).
# 요청을 보낼 때 다시 인코딩하므로 원본 값을 저장하세요. 인코딩된 값을 넣으면 이중 인코딩됩니다.
# 이 토큰은 만료될 수 있으며, 정확한 유효기간은 확인되지 않았습니다.
# 인증에 실패하면 캡챠를 다시 완료하고 CHKCAPT 값을 갱신하세요.
CHKCAPT=
CALLBACK=
SEAT_ID=
